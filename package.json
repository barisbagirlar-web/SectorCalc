{
  "name": "sectorcalc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Deterministic engineering calculators for the shop floor.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "seo:export-registry": "node scripts/export-seo-registry.mjs",
    "seo:generate-sitemap": "node scripts/generate-sitemap.mjs",
    "seo:generate-llm": "node scripts/generate-llm-discovery.mjs",
    "seo:generate": "npm run seo:export-registry && npm run seo:generate-sitemap && npm run seo:generate-llm",
    "build": "npm run seo:generate && node scripts/inject-guides.mjs && node scripts/inject-eeat.mjs && node scripts/inject-site-nav.mjs && node scripts/inject-related-tools.mjs && node scripts/inject-calc-sheet.mjs && python3 scripts/inject-seo.py && node scripts/verify-form-fields.mjs && tsc --noEmit && vite build && node scripts/verify-nav.mjs && node scripts/verify-form-fields.mjs && npm run verify:seo:enterprise",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:seo:registry": "node scripts/export-seo-registry.mjs",
    "verify:seo:llms": "node scripts/generate-llm-discovery.mjs && node scripts/verify-seo.mjs",
    "verify:seo:links": "node scripts/verify-internal-link-graph.mjs",
    "verify:seo:language": "node scripts/verify-language-integrity.mjs",
    "verify:seo:enterprise": "node scripts/verify-seo-enterprise.mjs",
    "verify:hero": "node scripts/verify-hero-sacred.mjs",
    "inject:guides": "node scripts/inject-guides.mjs",
    "inject:nav": "node scripts/inject-site-nav.mjs",
    "new:tool": "node scripts/new-tool.mjs",
    "verify:forms": "node scripts/verify-form-fields.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:deterministic": "vitest run tests/deterministic",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css,html}\"",
    "schema:validate": "node scripts/validate-schemas.js",
    "check:lang": "node scripts/check-language.mjs --strict",
    "check": "npm run format:check && npm run lint && npm run test",
    "inject:calc-sheet": "node scripts/inject-calc-sheet.mjs",
    "inject:eeat": "node scripts/inject-eeat.mjs"
  },
  "dependencies": {
    "ajv": "8.12.0",
    "ajv-formats": "2.1.1",
    "chart.js": "4.4.1",
    "decimal.js": "10.4.3",
    "dexie": "3.2.7",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "lit": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.42.1",
    "@vitest/coverage-v8": "1.3.1",
    "eslint": "8.57.0",
    "jsdom": "24.0.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "vite": "5.1.4",
    "vitest": "1.3.1"
  }
}
