{
  "name": "sectorcalc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Deterministic engineering calculators for the shop floor.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assert-production-env.mjs && node scripts/inject-guides.mjs && node scripts/inject-eeat.mjs && node scripts/inject-site-nav.mjs && node scripts/inject-related-tools.mjs && node scripts/inject-money-pages.mjs && node scripts/inject-aeo-hubs.mjs && node scripts/inject-free-tools-strip.mjs && node scripts/inject-free-tool-aeo.mjs && node scripts/inject-calc-sheet.mjs && node scripts/export-seo-registry.mjs && python3 scripts/inject-seo.py && node scripts/normalize-root-assets.mjs && node scripts/verify-form-fields.mjs && node scripts/verify-home-credit-packs.mjs && node scripts/verify-honest-credits.mjs && tsc --noEmit && vite build && node scripts/normalize-root-assets.mjs --dist && node scripts/normalize-root-assets.mjs --check --dist && node scripts/verify-nav.mjs && node scripts/verify-form-fields.mjs && node scripts/verify-seo.mjs && node scripts/verify-seo-money.mjs && node scripts/verify-hero-sacred.mjs && node scripts/verify-home-credit-packs.mjs && node scripts/verify-honest-credits.mjs && node scripts/verify-production-bundle.mjs",
    "inject:aeo": "node scripts/inject-aeo-hubs.mjs",
    "inject:free": "node scripts/inject-free-tools-strip.mjs && node scripts/inject-free-tool-aeo.mjs",
    "inject:money": "node scripts/inject-money-pages.mjs",
    "verify:home-credits": "node scripts/verify-home-credit-packs.mjs",
    "verify:honest-credits": "node scripts/verify-honest-credits.mjs",
    "verify:root-assets": "node scripts/normalize-root-assets.mjs --check --dist",
    "smoke:prod-env": "node scripts/assert-production-env.mjs",
    "smoke:paddle": "node scripts/smoke-paddle-sandbox.mjs",
    "verify:paddle-catalog": "node scripts/verify-paddle-catalog.mjs",
    "reconcile:purchases": "node scripts/reconcile-purchases.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:seo:registry": "node scripts/export-seo-registry.mjs",
    "verify:seo:llms": "node scripts/generate-llm-discovery.mjs && node scripts/verify-seo.mjs",
    "verify:seo:links": "node scripts/verify-internal-link-graph.mjs",
    "verify:seo:language": "node scripts/verify-language-integrity.mjs",
    "verify:seo:schema": "node scripts/verify-schema.mjs",
    "verify:seo:identity": "node scripts/verify-tool-content-identity.mjs",
    "verify:seo:enterprise": "node scripts/verify-seo-enterprise.mjs",
    "verify:seo:money": "node scripts/verify-seo-money.mjs",
    "verify:assets": "node scripts/normalize-root-assets.mjs --check",
    "verify:host-parity": "node scripts/verify-host-parity.mjs",
    "verify:legacy-surface": "node scripts/verify-legacy-surface.mjs",
    "seo:money:generate": "npx vite-node scripts/generate-worked-examples.mjs && node scripts/inject-money-pages.mjs",
    "verify:hero": "node scripts/verify-hero-sacred.mjs",
    "inject:guides": "node scripts/inject-guides.mjs",
    "inject:nav": "node scripts/inject-site-nav.mjs",
    "new:tool": "node scripts/new-tool.mjs",
    "verify:forms": "node scripts/verify-form-fields.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/export-regression-catalog.mjs --check && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:critical": "playwright test --project=chromium --grep @critical",
    "test:e2e:matrix": "playwright test --project=chromium --grep @matrix",
    "test:e2e:deep": "playwright test --project=chromium --grep @deep",
    "test:e2e:prod": "BASE_URL=https://sectorcalc.com playwright test --project=chromium --grep @critical",
    "test:e2e:preview": "playwright test --project=chromium --grep @critical",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:deterministic": "vitest run tests/deterministic",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css,html}\"",
    "schema:validate": "node scripts/validate-schemas.js",
    "check:lang": "node scripts/check-language.mjs --strict",
    "check": "npm run format:check && npm run lint && npm run test",
    "catalog:regression": "node scripts/export-regression-catalog.mjs",
    "catalog:regression:check": "node scripts/export-regression-catalog.mjs --check",
    "regression:ci": "npm run typecheck && npm run check:lang && npm run test:unit && npm run catalog:regression:check && npm run build && npm run test:e2e",
    "regression:prod": "npm run test:e2e:prod",
    "regression:visual": "REGRESSION_VISUAL=1 playwright test --project=chromium --grep @visual",
    "prepare": "husky",
    "inject:calc-sheet": "node scripts/inject-calc-sheet.mjs",
    "inject:eeat": "node scripts/inject-eeat.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{css,scss,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "ajv": "8.12.0",
    "ajv-formats": "2.1.1",
    "chart.js": "4.4.1",
    "decimal.js": "10.4.3",
    "dexie": "3.2.7",
    "firebase": "^10.14.1",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "lit": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.42.1",
    "@vitest/coverage-v8": "1.3.1",
    "eslint": "8.57.0",
    "husky": "^9.1.7",
    "jsdom": "24.0.0",
    "lint-staged": "^15.5.2",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "vite": "5.1.4",
    "vitest": "1.3.1"
  }
}
