rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isOpsAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^barisbagirlar@gmail\\.com$');
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isOpsAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.credits is int
        && request.resource.data.credits >= 0;
      // Owners cannot mutate credits; Cloud Functions (Admin SDK) own the ledger.
      allow update: if (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.credits == resource.data.credits
        ) || (
          isOpsAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.credits is int
          && request.resource.data.credits >= 0
        );
      allow delete: if false;

      match /wallet/{docId} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow write: if false;
      }

      match /creditTransactions/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow write: if false;
      }

      match /calculationSessions/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow write: if false;
      }

      match /purchases/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.credits is int
          && request.resource.data.credits > 0;
        allow update, delete: if false;
      }

      match /sessions/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isOpsAdmin();
      }
    }

    match /paymentEvents/{eventId} {
      allow read: if isOpsAdmin();
      allow write: if false;
    }

    match /ops_audit/{id} {
      allow read: if isOpsAdmin();
      allow create: if isOpsAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.actorEmail is string;
      allow update, delete: if false;
    }
  }
}
