rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    /** Ops console allowlist — must match VITE_OPS_ADMIN_EMAILS. */
    function isOpsAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^barisbagirlar@gmail\\.com$');
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isOpsAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.credits is int
        && request.resource.data.credits >= 0;
      allow update: if (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.credits is int
          && request.resource.data.credits >= 0
        ) || (
          isOpsAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.credits is int
          && request.resource.data.credits >= 0
        );
      allow delete: if false;
    }

    match /ops_audit/{id} {
      allow read: if isOpsAdmin();
      allow create: if isOpsAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.actorEmail is string;
      allow update, delete: if false;
    }
  }
}
