rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isOpsAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^barisbagirlar@gmail\\.com$');
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isOpsAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.credits is int
        && request.resource.data.credits >= 0;
      allow update: if (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.credits is int
          && request.resource.data.credits >= 0
          && request.resource.data.credits == resource.data.credits
        ) || (
          isOpsAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.credits is int
          && request.resource.data.credits >= 0
        );
      allow delete: if false;

      match /purchases/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.credits is int
          && request.resource.data.credits > 0;
        allow update, delete: if false;
      }

      match /sessions/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isOpsAdmin();
      }

      match /ledger/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow create: if (
            isOwner(uid)
            && request.resource.data.delta is int
            && request.resource.data.delta != 0
            && request.resource.data.kind is string
            && request.resource.data.label is string
          ) || (
            isOpsAdmin()
            && request.resource.data.delta is int
            && request.resource.data.delta != 0
            && request.resource.data.kind is string
            && request.resource.data.label is string
          );
        allow update, delete: if false;
      }
    }

    match /ops_audit/{id} {
      allow read: if isOpsAdmin();
      allow create: if isOpsAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.actorEmail is string;
      allow update, delete: if false;
    }

    /* Server-authoritative billing (Admin SDK only). */
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isOpsAdmin();
      allow write: if false;

      match /ledger/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow write: if false;
      }

      match /professional_sessions/{id} {
        allow read: if isOwner(uid) || isOpsAdmin();
        allow write: if false;
      }
    }

    match /billing_purchases/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOpsAdmin());
      allow write: if false;
    }

    /* Server-authoritative tool entitlements (Admin SDK only). */
    match /tool_entitlements/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOpsAdmin());
      allow write: if false;
    }

    match /paddle_webhook_events/{id} {
      allow read: if isOpsAdmin();
      allow write: if false;
    }
  }
}
