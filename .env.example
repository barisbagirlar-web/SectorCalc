# Paddle (Merchant of Record)
# PADDLE_ENV must be explicit: sandbox | production
PADDLE_ENV=sandbox
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# SERVER ONLY — never put these in VITE_* or frontend bundles
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# One-time price IDs (quantity 1..1, billing_cycle null). NEVER use INVALID monthly/unlocked IDs.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_WORKSHOP=
PADDLE_PRICE_PROFESSIONAL=
PADDLE_PRICE_TEAM_WALLET=

# Billing API (Cloud Functions). Empty → same-origin /api rewrite.
VITE_BILLING_API_BASE=

# Feature flags
CREDIT_MONETIZATION_ENABLED=false
VITE_CREDIT_MONETIZATION_ENABLED=false
PROMOTIONAL_TRIAL_CREDITS_ENABLED=false
# Free result preview: anonymous Tier-A users see numeric results; report/audit/export stay paywalled.
# true = new report-layer gate; false = legacy full lock (rollback).
VITE_ENABLE_FREE_RESULT_PREVIEW=false
